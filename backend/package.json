{
  "name": "vigilancia-backend",
  "version": "1.0.0",
  "description": "API para Vigilância Socioassistencial - protótipo",
  "main": "src/index.ts",
  "type": "commonjs",
  "scripts": {
    "db:dev:up": "docker compose up -d postgres-dev",
    "db:test:up": "docker compose up -d postgres-test",
    "db:down": "docker compose down",
    "dev": "node scripts/run-with-env.cjs .env.dev ts-node-dev --respawn --transpile-only src/index.ts",
    "seed": "npm run seed:dev",
    "seed:dev": "node scripts/run-with-env.cjs .env.dev ts-node src/seed.ts",
    "seed:test": "node scripts/run-with-env.cjs .env.test ts-node src/seed.ts",
    "start": "npm run start:prod",
    "start:prod": "node dist/index.js",
    "build": "rimraf dist && tsc -p .",
    "migrate:create": "node-pg-migrate create",
    "migrate": "npm run migrate:up:dev",
    "migrate:up": "npm run migrate:up:dev",
    "migrate:down": "npm run migrate:down:dev",
    "migrate:up:dev": "node scripts/run-with-env.cjs .env.dev node ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "migrate:down:dev": "node scripts/run-with-env.cjs .env.dev node ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down",
    "migrate:up:test": "node scripts/run-with-env.cjs .env.test node ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "migrate:down:test": "node scripts/run-with-env.cjs .env.test node ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down",
    "migrate:up:prod": "node scripts/run-with-env.cjs .env.prod node ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "test:schema": "npm run test:schema:dev",
    "test:schema:current": "jest --config jest.schema.config.ts --runInBand",
    "test:schema:dev": "node scripts/run-with-env.cjs .env.dev npm run test:schema:current",
    "test:schema:test": "node scripts/run-with-env.cjs .env.test npm run test:schema:current",
    "test": "node scripts/run-with-env.cjs .env.test jest --runInBand"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "cheerio": "^1.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-pg-migrate": "^8.0.4",
    "pdfkit": "^0.17.2",
    "pg": "^8.18.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/body-parser": "^1.19.6",
    "@types/cheerio": "^0.22.35",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.14",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "rimraf": "^6.1.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
